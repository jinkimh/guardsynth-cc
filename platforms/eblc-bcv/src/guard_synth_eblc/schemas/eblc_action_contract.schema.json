{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:eblc:action-contract:v0.1",
  "title": "EBLC bounded qualitative entry contract v0.1",
  "type": "object",
  "additionalProperties": false,
  "required": ["contract_version", "contract_id", "horizon", "claim_scope", "subject_id", "zone_id", "policy", "source_refs", "obligations"],
  "properties": {
    "contract_version": {"const": "eblc-action-contract-v0.1"},
    "contract_id": {"type": "string", "minLength": 1},
    "horizon": {"type": "integer", "minimum": 2},
    "claim_scope": {"const": "CONDITIONAL_ACTION_SELECTION_NOT_VEHICLE_SAFETY"},
    "subject_id": {"type": "string", "minLength": 1},
    "zone_id": {"type": ["string", "null"], "minLength": 1},
    "policy": {"const": "CLEAR_REQUIRED_FOR_ENTRY"},
    "source_refs": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
    "obligations": {"type": "array", "minItems": 1, "maxItems": 16, "items": {"$ref": "#/$defs/obligation"}}
  },
  "$defs": {
    "obligation": {
      "type": "object", "additionalProperties": false,
      "required": ["obligation_id", "predicate_id", "target_entity_id", "rule_ref", "source_refs"],
      "properties": {
        "obligation_id": {"type": "string", "minLength": 1},
        "predicate_id": {"type": "string", "minLength": 1},
        "target_entity_id": {"type": ["string", "null"], "minLength": 1},
        "rule_ref": {"type": "string", "minLength": 1},
        "source_refs": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}}
      }
    }
  }
}
