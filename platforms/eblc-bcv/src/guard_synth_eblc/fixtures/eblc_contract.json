    }
  ],
  "coordinate_frame": "ego_path_s",
  "distance_unit": "m",
  "predicate_maximum_age_s": 0.2,
  "maximum_service_deceleration_mps2": 3.0,
  "response_time_s": 0.5,
  "position_uncertainty_m": 0.5,
