\@writefile{lot}{\contentsline {table}{\numberline {12}{\ignorespaces 차단장치의 안전 이득과 개입 비용. 값은 세 난수 초기값 평균이며, 변화량은 차단장치가 없는 대응 계약 대비 차단장치 조건의 차이다. 모든 조건의 목표 완료율은 1.000이었다.}}{13}{table.caption.44}\protected@file@percent }
\newlabel{tab:shield-cost}{{12}{13}{차단장치의 안전 이득과 개입 비용. 값은 세 난수 초기값 평균이며, 변화량은 차단장치가 없는 대응 계약 대비 차단장치 조건의 차이다. 모든 조건의 목표 완료율은 1.000이었다}{table.caption.44}{}}
