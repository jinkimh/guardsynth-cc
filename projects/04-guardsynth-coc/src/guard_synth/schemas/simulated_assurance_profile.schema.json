{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:guardsynth:simulated-assurance-profile:v0.1",
  "title": "GuardSynth simulated longitudinal assurance profile v0.1",
  "type": "object",
  "required": ["model_version", "profile_id", "profile_class", "simulation_vehicle_binding_key", "scope", "parameters", "limitations"],
  "additionalProperties": false,
  "properties": {
    "model_version": {"const": "guardsynth-simulated-longitudinal-model-v0.1"},
    "profile_id": {"type": "string", "minLength": 1},
    "profile_class": {"const": "SIMULATED_ASSURANCE"},
    "simulation_vehicle_binding_key": {"type": "string", "minLength": 1},
    "scope": {"const": "SIMULATOR_ONLY_NOT_REAL_VEHICLE_ASSURANCE"},
    "parameters": {
      "type": "object",
      "required": ["maximum_service_deceleration_mps2", "response_time_s", "position_uncertainty_m", "integration_step_s"],
      "additionalProperties": false,
      "properties": {
        "maximum_service_deceleration_mps2": {"type": "number", "minimum": 0},
        "response_time_s": {"type": "number", "minimum": 0},
        "position_uncertainty_m": {"type": "number", "minimum": 0},
        "integration_step_s": {"type": "number", "minimum": 0}
      }
    },
    "limitations": {
      "type": "array",
      "minItems": 1,
      "items": {"type": "string", "minLength": 1}
    }
  }
}
