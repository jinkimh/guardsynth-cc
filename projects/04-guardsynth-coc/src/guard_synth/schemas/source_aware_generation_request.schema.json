{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:guardsynth:source-aware-generation-request:v0.1",
  "title": "Source-aware GuardSynth request v0.1",
  "type": "object",
  "required": ["generator_version", "request_id", "template_program_ref", "rule_template_ref", "predicate_spec_ref", "frames", "claim_scope", "source_refs", "policy", "vehicle_profile", "context_graph"],
  "additionalProperties": false,
  "properties": {
    "generator_version": {"const": "guard-synth-source-aware-generator-v0.1"},
    "request_id": {"type": "string", "minLength": 1},
    "template_program_ref": {"type": "string", "minLength": 1},
    "rule_template_ref": {"type": "string", "minLength": 1},
    "predicate_spec_ref": {"type": "string", "minLength": 1},
    "frames": {"type": "integer", "minimum": 1},
    "claim_scope": {"type": "string", "minLength": 1},
    "source_refs": {"$ref": "#/$defs/ref_array"},
    "policy": {
      "type": "object",
      "required": ["subject_id", "predicate_evidence_ref", "compiler_policy_evidence_ref", "composition_evidence_refs", "action_domain", "allowed_actions", "release_enabled", "reactivation_enabled", "unknown_policy", "always_active", "expiry_timestamp_s", "enforce_invariant", "force_deadlock", "position_epsilon_m", "speed_epsilon_mps", "time_epsilon_s"],
      "additionalProperties": false,
      "properties": {
        "subject_id": {"type": "string", "minLength": 1},
        "predicate_evidence_ref": {"type": "string", "minLength": 1},
        "compiler_policy_evidence_ref": {"type": "string", "minLength": 1},
        "composition_evidence_refs": {"$ref": "#/$defs/ref_array"},
        "action_domain": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
        "allowed_actions": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
        "release_enabled": {"type": "boolean"},
        "reactivation_enabled": {"type": "boolean"},
        "unknown_policy": {"const": "APPROVED_HOLD"},
        "always_active": {"type": "boolean"},
        "expiry_timestamp_s": {"type": ["number", "null"], "minimum": 0},
        "enforce_invariant": {"type": "boolean"},
        "force_deadlock": {"type": "boolean"},
        "position_epsilon_m": {"type": "number", "minimum": 0},
        "speed_epsilon_mps": {"type": "number", "minimum": 0},
        "time_epsilon_s": {"type": "number", "minimum": 0}
      }
    },
    "vehicle_profile": {
      "type": ["object", "null"],
      "required": ["profile_id", "maximum_service_deceleration_mps2", "response_time_s", "position_uncertainty_m", "evidence_ref"],
      "additionalProperties": false,
      "properties": {
        "profile_id": {"type": "string", "minLength": 1},
        "maximum_service_deceleration_mps2": {"type": "number"},
        "response_time_s": {"type": "number"},
        "position_uncertainty_m": {"type": "number"},
        "evidence_ref": {"type": "string", "minLength": 1}
      }
    },
    "context_graph": {
      "type": "object",
      "required": ["graph_id", "timestamp_s", "source_refs", "coc_claims", "instances"],
      "additionalProperties": false,
      "properties": {
        "graph_id": {"type": "string", "minLength": 1},
        "timestamp_s": {"type": "number", "minimum": 0},
        "source_refs": {"$ref": "#/$defs/ref_array"},
        "coc_claims": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["claim_id", "epistemic_kind", "evidence_ref"],
            "additionalProperties": false,
            "properties": {
              "claim_id": {"type": "string", "minLength": 1},
              "epistemic_kind": {"const": "CLAIMED"},
              "evidence_ref": {"type": "string", "minLength": 1}
            }
          }
        },
        "instances": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "required": ["instance_id", "contract_id", "hazard_fact", "association", "zone_entry", "overrides_contracts"],
            "additionalProperties": false,
            "properties": {
              "instance_id": {"type": "string", "minLength": 1},
              "contract_id": {"type": "string", "minLength": 1},
              "overrides_contracts": {"type": "array", "items": {"type": "string", "minLength": 1}},
              "hazard_fact": {
                "type": "object",
                "required": ["truth", "epistemic_kind", "source_ref", "timestamp_s", "maximum_age_s"],
                "additionalProperties": false,
                "properties": {
                  "truth": {"type": "string", "enum": ["TRUE", "FALSE", "UNKNOWN", "CONFLICT"]},
                  "epistemic_kind": {"type": "string", "enum": ["OBSERVED", "PREDICTED", "DERIVED", "CLAIMED"]},
                  "source_ref": {"type": "string", "minLength": 1},
                  "timestamp_s": {"type": "number", "minimum": 0},
                  "maximum_age_s": {"type": "number", "minimum": 0}
                }
              },
              "association": {
                "type": "object",
                "required": ["selected_target_entity_id", "selected_zone_id", "candidate_target_entity_ids", "candidate_zone_ids", "zone_geometry_ref", "coordinate_transform_ref", "evidence_refs"],
                "additionalProperties": false,
                "properties": {
                  "selected_target_entity_id": {"type": ["string", "null"], "minLength": 1},
                  "selected_zone_id": {"type": ["string", "null"], "minLength": 1},
                  "candidate_target_entity_ids": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
                  "candidate_zone_ids": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
                  "zone_geometry_ref": {"type": ["string", "null"], "minLength": 1},
                  "coordinate_transform_ref": {"type": ["string", "null"], "minLength": 1},
                  "evidence_refs": {"$ref": "#/$defs/ref_array"}
                }
              },
              "zone_entry": {
                "type": ["object", "null"],
                "required": ["value", "unit", "frame", "evidence_refs"],
                "additionalProperties": false,
                "properties": {
                  "value": {"type": "number"},
                  "unit": {"type": "string", "minLength": 1},
                  "frame": {"type": "string", "minLength": 1},
                  "evidence_refs": {"$ref": "#/$defs/ref_array"}
                }
              }
            }
          }
        }
      }
    }
  },
  "$defs": {
    "ref_array": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}}
  }
}
