{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:guardsynth:image-review-partial-scene-packet:v0.1",
  "title": "GuardSynth image-review partial scene packet v0.1",
  "type": "object",
  "required": [
    "packet_version", "packet_id", "scene_ref", "input_class", "source_review",
    "review_evidence", "observations", "selection_hints", "source_closure"
  ],
  "additionalProperties": false,
  "properties": {
    "packet_version": {"const": "guardsynth-image-review-partial-scene-v0.1"},
    "packet_id": {"type": "string", "minLength": 1},
    "scene_ref": {"type": "string", "minLength": 1},
    "input_class": {"const": "LICENSE_RESTRICTED_IMAGE_REVIEW"},
    "source_review": {
      "type": "object",
      "required": ["document_sha256", "exported_at", "review_version", "image_filename"],
      "additionalProperties": false,
      "properties": {
        "document_sha256": {"type": "string", "minLength": 64},
        "exported_at": {"type": "string", "minLength": 1},
        "review_version": {"type": "string", "minLength": 1},
        "image_filename": {"type": "string", "minLength": 1}
      }
    },
    "review_evidence": {
      "type": "object",
      "required": ["evidence_ref", "evidence_kind", "review_id", "reviewer_id", "review_completed_at"],
      "additionalProperties": false,
      "properties": {
        "evidence_ref": {"type": "string", "minLength": 1},
        "evidence_kind": {"const": "HUMAN_REVIEWED_IMAGE_CLAIM"},
        "review_id": {"type": "string", "minLength": 1},
        "reviewer_id": {"type": "string", "minLength": 1},
        "review_completed_at": {"type": "string", "minLength": 1}
      }
    },
    "observations": {
      "type": "object",
      "required": [
        "scene_tags", "image_usability", "primary_situation", "visual_hazard",
        "subject_description", "candidate_region", "subject_region_relation", "occlusion",
        "traffic_control", "ego_motion_impression", "temporal_change", "human_disposition",
        "recommended_disposition", "review_confidence", "override_reason", "notes"
      ],
      "additionalProperties": false,
      "properties": {
        "scene_tags": {"type": "array", "items": {"type": "string", "minLength": 1}},
        "image_usability": {"type": "string", "minLength": 1},
        "primary_situation": {"type": "string", "minLength": 1},
        "visual_hazard": {"type": "string", "minLength": 1},
        "subject_description": {"type": "string"},
        "candidate_region": {"type": "string", "minLength": 1},
        "subject_region_relation": {"type": "string", "minLength": 1},
        "occlusion": {"type": "string", "minLength": 1},
        "traffic_control": {"type": "string", "minLength": 1},
        "ego_motion_impression": {"type": "string", "minLength": 1},
        "temporal_change": {"type": "string", "minLength": 1},
        "human_disposition": {"type": "string", "minLength": 1},
        "recommended_disposition": {"type": "string", "minLength": 1},
        "review_confidence": {"type": "string", "minLength": 1},
        "override_reason": {"type": "string"},
        "notes": {"type": "string"}
      }
    },
    "selection_hints": {
      "type": "object",
      "required": ["candidate_slices", "candidate_strata", "slot_assignment_status"],
      "additionalProperties": false,
      "properties": {
        "candidate_slices": {"type": "array", "items": {"type": "string", "enum": ["PEDESTRIAN_CYCLIST_YIELD", "STOP_SIGNALS", "FOLLOWING_CUT_IN"]}},
        "candidate_strata": {"type": "array", "items": {"type": "string", "enum": ["HAZARD_VISIBLE", "HAZARD_OCCLUDED_OR_REAPPEARING", "NOMINAL_CLEAR", "RELEASE_OR_REACTIVATION"]}},
        "slot_assignment_status": {"const": "UNASSIGNED_REVIEW_REQUIRED"}
      }
    },
    "source_closure": {
      "type": "object",
      "required": [
        "status", "source_complete", "contract_generation_allowed", "missing_fields",
        "reason_codes", "synthesized_required_values"
      ],
      "additionalProperties": false,
      "properties": {
        "status": {"const": "REVIEW_REQUIRED"},
        "source_complete": {"const": false},
        "contract_generation_allowed": {"const": false},
        "missing_fields": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
        "reason_codes": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
        "synthesized_required_values": {"type": "array", "maxItems": 0, "items": {"type": "string"}}
      }
    }
  }
}
