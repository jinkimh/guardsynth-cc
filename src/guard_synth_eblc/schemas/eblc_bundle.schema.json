{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:eblc:bundle:v0.1",
  "title": "High-level EBLC multi-contract bundle v0.1",
  "type": "object",
  "required": ["bundle_version", "bundle_id", "frames", "claim_scope", "source_refs", "action_domain", "contracts", "composition_evidence_refs"],
  "additionalProperties": false,
  "properties": {
    "bundle_version": {"const": "eblc-bundle-v0.1"},
    "bundle_id": {"type": "string", "minLength": 1},
    "frames": {"type": "integer", "minimum": 1},
    "claim_scope": {"type": "string", "minLength": 1},
    "source_refs": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
    "action_domain": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
    "contracts": {
      "type": "array",
      "minItems": 2,
      "items": {
        "type": "object",
        "required": ["contract_id", "program", "priority_tier", "allowed_actions", "overrides_contracts", "evidence_refs"],
        "additionalProperties": false,
        "properties": {
          "contract_id": {"type": "string", "minLength": 1},
          "program": {"type": "object"},
          "priority_tier": {"type": "string", "enum": ["HARD", "SERVICE", "PREFERENCE"]},
          "allowed_actions": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
          "overrides_contracts": {"type": "array", "items": {"type": "string", "minLength": 1}},
          "evidence_refs": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}}
        }
      }
    },
    "composition_evidence_refs": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}}
  }
}
