{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:eblc:derivation:v0.1",
  "title": "Typed EBLC derivation specification v0.1",
  "type": "object",
  "required": ["derivation_version", "derivation_id", "horizon", "claim_scope", "source_refs", "symbols", "nodes", "outputs"],
  "additionalProperties": false,
  "properties": {
    "derivation_version": {"const": "eblc-derivation-v0.1"},
    "derivation_id": {"type": "string", "minLength": 1},
    "horizon": {"type": "integer", "minimum": 2},
    "claim_scope": {"type": "string", "minLength": 1},
    "source_refs": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
    "symbols": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/symbol"}},
    "nodes": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/node"}},
    "outputs": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/output"}}
  },
  "$defs": {
    "symbol": {
      "type": "object",
      "required": ["symbol_id", "kind", "sort", "time_varying", "value", "core_name", "unit", "frame", "evidence_refs"],
      "additionalProperties": false,
      "properties": {
        "symbol_id": {"type": "string", "minLength": 1},
        "kind": {"type": "string", "enum": ["SOURCED_VALUE", "CORE_VARIABLE"]},
        "sort": {"type": "string", "enum": ["INT", "REAL"]},
        "time_varying": {"type": "boolean"},
        "value": {"type": ["number", "null"]},
        "core_name": {"type": ["string", "null"]},
        "unit": {"type": ["string", "null"]},
        "frame": {"type": ["string", "null"]},
        "evidence_refs": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}}
      }
    },
    "node": {
      "type": "object",
      "required": ["node_id", "operation", "inputs", "source_refs"],
      "additionalProperties": false,
      "properties": {
        "node_id": {"type": "string", "minLength": 1},
        "operation": {"type": "string", "enum": ["ADD", "SUB", "MUL", "DIV", "NEG", "MIN", "MAX"]},
        "inputs": {"type": "array", "minItems": 1, "maxItems": 2, "items": {"type": "string", "minLength": 1}},
        "source_refs": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}}
      }
    },
    "output": {
      "type": "object",
      "required": ["output_id", "node_ref", "target_declaration", "sort", "time_varying", "unit", "frame", "replace_clause_ids", "evidence_refs"],
      "additionalProperties": false,
      "properties": {
        "output_id": {"type": "string", "minLength": 1},
        "node_ref": {"type": "string", "minLength": 1},
        "target_declaration": {"type": "string", "minLength": 1},
        "sort": {"type": "string", "enum": ["INT", "REAL"]},
        "time_varying": {"type": "boolean"},
        "unit": {"type": ["string", "null"]},
        "frame": {"type": ["string", "null"]},
        "replace_clause_ids": {"type": "array", "items": {"type": "string", "minLength": 1}},
        "evidence_refs": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}}
      }
    }
  }
}
