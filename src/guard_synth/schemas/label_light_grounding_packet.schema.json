{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:guardsynth:label-light-grounding-packet:v0.1",
  "title": "GuardSynth label-light grounding packet v0.1",
  "type": "object",
  "required": ["packet_version", "packet_id", "scene_ref", "timestamp_s", "source_refs", "policy", "hazard", "targets", "zones", "pair_candidates", "vehicle_binding_key", "assurance_scope"],
  "additionalProperties": false,
  "properties": {
    "packet_version": {"const": "guardsynth-label-light-grounding-v0.1"},
    "packet_id": {"type": "string", "minLength": 1},
    "scene_ref": {"type": "string", "minLength": 1},
    "timestamp_s": {"type": "number", "minimum": 0},
    "source_refs": {"$ref": "#/$defs/ref_array"},
    "vehicle_binding_key": {"type": "string", "minLength": 1},
    "assurance_scope": {"type": "string", "minLength": 1},
    "policy": {
      "type": "object",
      "required": ["auto_confirm_enabled", "minimum_confidence_lower_bound", "require_unique_candidate_pair", "approved_calibration_evidence_refs", "policy_evidence_ref"],
      "additionalProperties": false,
      "properties": {
        "auto_confirm_enabled": {"type": "boolean"},
        "minimum_confidence_lower_bound": {"type": "number", "minimum": 0},
        "require_unique_candidate_pair": {"type": "boolean"},
        "approved_calibration_evidence_refs": {"$ref": "#/$defs/ref_array"},
        "policy_evidence_ref": {"type": "string", "minLength": 1}
      }
    },
    "hazard": {
      "type": "object",
      "required": ["truth", "epistemic_kind", "evidence_ref", "timestamp_s", "maximum_age_s"],
      "additionalProperties": false,
      "properties": {
        "truth": {"type": "string", "enum": ["TRUE", "FALSE", "UNKNOWN", "CONFLICT"]},
        "epistemic_kind": {"type": "string", "enum": ["OBSERVED", "PREDICTED", "DERIVED", "CLAIMED"]},
        "evidence_ref": {"type": "string"},
        "timestamp_s": {"type": "number", "minimum": 0},
        "maximum_age_s": {"type": "number", "minimum": 0}
      }
    },
    "targets": {
      "type": "array", "minItems": 1,
      "items": {
        "type": "object", "required": ["target_entity_id", "classification", "track_evidence_ref"],
        "additionalProperties": false,
        "properties": {
          "target_entity_id": {"type": "string", "minLength": 1},
          "classification": {"type": "string", "minLength": 1},
          "track_evidence_ref": {"type": "string"}
        }
      }
    },
    "zones": {
      "type": "array", "minItems": 1,
      "items": {
        "type": "object", "required": ["zone_id", "entry_x_m", "frame", "geometry_evidence_ref", "transform_verified", "transform_evidence_ref"],
        "additionalProperties": false,
        "properties": {
          "zone_id": {"type": "string", "minLength": 1},
          "entry_x_m": {"type": "number"},
          "frame": {"type": "string", "minLength": 1},
          "geometry_evidence_ref": {"type": "string"},
          "transform_verified": {"type": "boolean"},
          "transform_evidence_ref": {"type": "string"}
        }
      }
    },
    "pair_candidates": {
      "type": "array", "minItems": 1,
      "items": {
        "type": "object", "required": ["target_entity_id", "zone_id", "path_intersection", "association_evidence_ref", "confidence_lower_bound", "confidence_upper_bound", "calibration_evidence_ref"],
        "additionalProperties": false,
        "properties": {
          "target_entity_id": {"type": "string", "minLength": 1},
          "zone_id": {"type": "string", "minLength": 1},
          "path_intersection": {"type": "string", "enum": ["TRUE", "FALSE", "UNKNOWN", "CONFLICT"]},
          "association_evidence_ref": {"type": "string"},
          "confidence_lower_bound": {"type": "number", "minimum": 0},
          "confidence_upper_bound": {"type": "number", "minimum": 0},
          "calibration_evidence_ref": {"type": "string"}
        }
      }
    }
  },
  "$defs": {
    "ref_array": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}}
  }
}
